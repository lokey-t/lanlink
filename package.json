{
  "name": "lanlink",
  "version": "0.92.0",
  "private": true,
  "type": "module",
  "description": "Offline LAN keyboard, clipboard and remote desktop sharing",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start-native.js",
    "dev:http": "node src/main.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "icons": "node scripts/icon.js",
    "package:mac": "sh scripts/package-macos.sh",
    "package:update": "node scripts/build-update.js"
  },
  "dependencies": {
    "koffi": "2.15.1",
    "werift": "0.24.4"
  }
}
